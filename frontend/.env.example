# --- Chain (dev-docs.botchain.ai, verified live 2026-08-19) --------------
# Mainnet: chain 677, https://rpc.botchain.ai, https://scan.botchain.ai
# Testnet: chain 968, https://rpc.bohr.life, https://scan.bohr.life  (bohr.life, not botchain.ai)
NEXT_PUBLIC_CHAIN_ID=677
NEXT_PUBLIC_CHAIN_NAME=BOT Chain
NEXT_PUBLIC_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_EXPLORER_URL=https://scan.botchain.ai
NEXT_PUBLIC_IS_TESTNET=false

# Testnet swap — explicit opt-in; the mock token there does have a faucet:
# NEXT_PUBLIC_CHAIN_ID=968
# NEXT_PUBLIC_CHAIN_NAME=BOT Chain Testnet
# NEXT_PUBLIC_RPC_URL=https://rpc.bohr.life
# NEXT_PUBLIC_EXPLORER_URL=https://scan.bohr.life
# NEXT_PUBLIC_IS_TESTNET=true
# NEXT_PUBLIC_TOKEN_SYMBOL=BOT
# NEXT_PUBLIC_TOKEN_HAS_FAUCET=true

# --- Contracts — printed by the deploy script ---------------------------
NEXT_PUBLIC_INTENT_VAULT=
NEXT_PUBLIC_STRATEGY_REGISTRY=
NEXT_PUBLIC_APPROVAL_GATE=
# Mainnet deposit token is real WBOT (no faucet); testnet uses the mock.
NEXT_PUBLIC_TEST_TOKEN=0xD5452816194a3784dBa983426cCe7c122F4abd30
NEXT_PUBLIC_TOKEN_SYMBOL=WBOT
NEXT_PUBLIC_TOKEN_DECIMALS=18
NEXT_PUBLIC_TOKEN_HAS_FAUCET=false

# --- Agent API ----------------------------------------------------------
NEXT_PUBLIC_AGENT_API=http://localhost:8000

# WalletConnect Cloud project id (injected wallets work without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
