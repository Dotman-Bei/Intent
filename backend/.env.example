# --- AI -----------------------------------------------------------------
# Without a key the agent falls back to its deterministic rule-based parser,
# so the whole flow still runs offline (useful for demos and CI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Chain --------------------------------------------------------------
# BOT Chain (dev-docs.botchain.ai, verified live 2026-08-19).
# Testnet: chain 968, https://rpc.bohr.life  (bohr.life, not botchain.ai)
# Mainnet: chain 677, https://rpc.botchain.ai
BOT_RPC_URL=https://rpc.bohr.life
CHAIN_ID=968
EXPLORER_URL=https://scan.bohr.life

STRATEGY_REGISTRY_ADDRESS=
INTENT_VAULT_ADDRESS=
APPROVAL_GATE_ADDRESS=
TEST_TOKEN_ADDRESS=
TOKEN_DECIMALS=18

# Optional: lets the backend broadcast executeIntent itself. Leave empty to run
# in plan-only mode, where the frontend signs every transaction.
AGENT_PRIVATE_KEY=

# --- Policy -------------------------------------------------------------
# Default human-in-the-loop threshold (whole tokens) used when a user has not
# configured their own on-chain threshold yet.
DEFAULT_APPROVAL_THRESHOLD=100

# --- Server -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
