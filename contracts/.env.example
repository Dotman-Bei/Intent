# --- BOT Chain networks (dev-docs.botchain.ai, verified live 2026-08-19) ---
# Testnet lives on bohr.life, NOT botchain.ai.
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_TESTNET_CHAIN_ID=968

BOT_MAINNET_RPC=https://rpc.botchain.ai
BOT_MAINNET_CHAIN_ID=677

# Deployer key (never commit the real file).
# Testnet BOT: https://faucet.botchain.ai/basic/
# Mainnet BOT: swap on https://dex.botchain.ai/, or the Challenge gas grant (1 BOT).
PRIVATE_KEY=

# Agent executor EOA — the wallet allowed to call executeIntent on behalf of users.
# Safe to set equal to the deployer for a demo; use a separate hot wallet in production.
AGENT_ADDRESS=

# Explorer verification (BOTScan)
BOTSCAN_API_KEY=

# Mainnet only: real venues to whitelist, JSON array. The deploy script refuses to run empty.
# [{"protocol":"0x..","name":"B DEX Pool","protocolType":"DEX","riskScore":3,"baseApyBps":850}]
MAINNET_STRATEGIES=
